# ──────────────────────────────────────────────────────────────────────────────
# StyleSync Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the .NET Web API (no trailing slash)
# Development default: http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL of the Python / FastAPI AI service
# Development default: http://localhost:8000
VITE_AI_SERVICE_URL=http://localhost:8000

# Application display name shown in browser tabs and OG tags
VITE_APP_NAME=StyleSync

# Feature flags (set to "true" or "false")
# Enable AI-powered style analysis in project request wizard
VITE_FEATURE_AI_ANALYSIS=true
# Enable designer marketplace module
VITE_FEATURE_DESIGNERS=true
